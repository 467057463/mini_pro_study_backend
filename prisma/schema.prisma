// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value Json
  name  String
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  order     Order[]
  address   Address?
  profile   Profile?
}

model SuperUser {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  role      superUserRole @default(admin)
}

model Address {
  id      Int    @id @default(autoincrement())
  address String
  user    User   @relation(fields: [userId], references: [id])
  userId  Int    @unique
}

model Profile {
  id     Int    @id @default(autoincrement())
  phone  BigInt
  user   User   @relation(fields: [userId], references: [id])
  userId Int    @unique
}

model Category {
  id       Int        @id @default(autoincrement())
  name     String     @unique
  label    String     @unique
  order    Int
  parentId Int?
  parent   Category?  @relation("CageGoryList", fields: [parentId], references: [id])
  children Category[] @relation("CageGoryList")
  products Product[]
}

model Product {
  id                Int                @id @default(autoincrement())
  name              String             @unique
  price             Float              @default(0)
  image             String
  count             Int                @default(0) @db.UnsignedInt
  status            productStatus      @default(normal)
  categoryId        Int?
  category          Category?          @relation(fields: [categoryId], references: [id])
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  productSnapshoots ProductSnapshoot[]
}

model ProductSnapshoot {
  id           Int     @id @default(autoincrement())
  name         String
  price        Float   @default(0)
  image        String
  count        Int     @default(0) @db.UnsignedInt
  originId     Int
  orginProduct Product @relation(fields: [originId], references: [id])
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id])
}

model Order {
  id           String             @id @default(uuid())
  type         orderType          @default(selfPick)
  status       orderStatus        @default(normal)
  dispatchTime DateTime           @default(now())
  price        Float              @default(0)
  remark       String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  customer     User               @relation(fields: [customerId], references: [id])
  customerId   Int
  products     ProductSnapshoot[]
}

enum superUserRole {
  admin
  operator
  courier
}

enum productStatus {
  normal
  soldOut
}

enum orderType {
  selfPick
  takeOut
  pointPick
}

enum orderStatus {
  normal
  material
  inProduction
  dispatching
  success
}
